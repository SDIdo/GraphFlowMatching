# Per-site settings, sourced by sbatch/run_gfm.sbatch if sbatch/site.env exists.
#
#   cp sbatch/site.env.example sbatch/site.env
#   $EDITOR sbatch/site.env
#
# site.env is gitignored: it holds paths specific to YOUR cluster, so it must
# not travel with the repo. Anything you export here becomes the default for
# every submission. Use the ${VAR:-default} form shown below so an explicit
# VAR=... on the sbatch command line still overrides it.

# ImageNet root -- the directory holding the wnid folders (directly or under
# train/), OR the HuggingFace parquet shards (*.parquet, directly or under data/).
# export DATA_ROOT_IMAGENET="${DATA_ROOT_IMAGENET:-/groups/eliasof_group/sananest/ImageNet}"

# Where encoded latents, checkpoints and results go. Defaults to $PWD/work.
# Point this at scratch if your home quota is small.
# export WORK_DIR="${WORK_DIR:-/scratch/$USER/gfm}"

# Official ImageNet-LT split list. Auto-detected under DATA_ROOT_IMAGENET, so
# only set this if the images and the .txt files live in different places.
# export IMAGENET_LT_SPLIT="${IMAGENET_LT_SPLIT:-/groups/eliasof_group/sananest/ImageNet/ImageNet_LT/ImageNet_LT_train.txt}"

# Training budget overrides.
# export EPOCHS="${EPOCHS:-25}"
# BATCH_SIZE is the EFFECTIVE batch (what the optimizer sees). MICRO_BATCH is
# what one forward/backward has to fit in VRAM; the job accumulates
# BATCH_SIZE / MICRO_BATCH of them per step. Leave MICRO_BATCH at 'auto' to have
# it chosen from the card's memory (32 on a 24 GB 3090/4090), or pin it here.
# export BATCH_SIZE="${BATCH_SIZE:-64}"
# export MICRO_BATCH="${MICRO_BATCH:-auto}"
