__pycache__/
*.pyc
*.pt
*.ckpt
*.pth
wandb/
runs/
logs/
data/
*.zip
.DS_Store

# LaTeX build artefacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.toc
paper/*.synctex.gz
paper/build.log
paper/figures/*.png
paper/figures/*.pdf

# pipeline outputs
work/
runs/
results/
# Slurm opens --output BEFORE the job script runs, so sbatch/logs/ must
# already exist or the job dies at launch with no log at all. Ignore the
# log files but keep the directory marker -- note the directory itself has
# to be un-ignored first, because git will not re-include a file whose
# parent directory is excluded (by `logs/` above).
!sbatch/logs/
!sbatch/logs/.gitkeep
sbatch/logs/*.out
sbatch/logs/*.err

# Virtualenvs -- never commit, and protect from `git clean -fd`
.venv/
venv/
env/
